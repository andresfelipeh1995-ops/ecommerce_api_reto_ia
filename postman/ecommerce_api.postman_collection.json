  "item": [
    {
      "name": "01 · Auth",
      "item": [
        {
          "name": "Login usuario (Ana)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('devuelve access_token', () => pm.expect(data.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', data.access_token);",
                  "const payload = JSON.parse(atob(data.access_token.split('.')[1]));",
                  "pm.collectionVariables.set('userId', payload.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "ana@correo.com" },
                { "key": "password", "value": "Clave12345" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Email: ana@correo.com / Contraseña: Clave12345"
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', data.access_token);",
                  "const payload = JSON.parse(atob(data.access_token.split('.')[1]));",
                  "pm.collectionVariables.set('adminId', payload.sub);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin@shop.com" },
                { "key": "password", "value": "Admin12345" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Email: admin@shop.com / Contraseña: Admin12345"
          }
        },
        {
          "name": "Login inválido (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
