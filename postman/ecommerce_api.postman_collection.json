                  "const data = pm.response.json();",
                  "pm.test('devuelve un array', () => pm.expect(data).to.be.an('array'));",
                  "if (data.length > 0) pm.collectionVariables.set('productId', data[0].id);",
                  "if (data.length > 1) pm.collectionVariables.set('product2Id', data[1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
